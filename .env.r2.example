# Cloudflare R2 — preencha no ambiente do servidor, nunca no frontend/GitHub
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=narabot-cartas
# URL pública do bucket (ex.: https://imagens.seudominio.com ou URL r2.dev)
R2_PUBLIC_BASE_URL=

# CDN de imagens públicas de cartas.
# Por padrão, reutiliza R2_BUCKET_NAME e R2_PUBLIC_BASE_URL acima.
# Defina R2_PUBLIC_CARDS_BASE_URL para o domínio customizado da Cloudflare
# (ex.: https://img.seudominio.com). Bucket separado é opcional.
R2_PUBLIC_CARDS_BUCKET_NAME=
R2_PUBLIC_CARDS_BASE_URL=
# Opcionais; vazios = reutilizar as credenciais R2_* acima.
R2_PUBLIC_CARDS_ACCOUNT_ID=
R2_PUBLIC_CARDS_ACCESS_KEY_ID=
R2_PUBLIC_CARDS_SECRET_ACCESS_KEY=
