# Copie para .env e preencha os valores no servidor. Nunca versione o .env real.
DISCORD_TOKEN=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://SEU-DOMINIO/auth/discord/callback
SOULSBOT_WEB_SESSION_SECRET=
SOULSBOT_PUBLIC_URL=https://SEU-DOMINIO

# Use true somente para uma instalação genuinamente nova, sem coleção antiga.
# Se já existir comunidade/coleção, restaure o backup real antes de iniciar.
SOULSBOT_ALLOW_EMPTY_DATABASE=false

# Docker Compose fixa DATA_DIR e DB_PATH em /data.
HOST_BIND_IP=127.0.0.1
HOST_PORT=8080

# Opcionais
GUILD_ID=
DISCORD_INVITE_URL=
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY=
GEMINI_THIRD_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
