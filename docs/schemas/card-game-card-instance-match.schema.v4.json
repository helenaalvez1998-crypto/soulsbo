{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulsbo.local/schemas/card-instance-match.v4.json",
  "title": "Soulsbo Match CardInstance Contract v0.4 (Groups A, B and C approved; D/F/E open)",
  "description": "Draft estrutural após aprovações dos Grupos A, B e C. Políticas de seleção/atomicidade, causas finais de remoção e persistência/migração real continuam abertas; não integrado.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "match_id",
    "state_revision",
    "status",
    "players",
    "instances",
    "operations",
    "definition_manifest",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "match_id": {
      "type": "integer",
      "minimum": 1
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "active",
        "finished"
      ]
    },
    "players": {
      "type": "object",
      "minProperties": 2,
      "patternProperties": {
        "^-?(?:0|[1-9][0-9]*)$": {
          "$ref": "#/$defs/player"
        }
      },
      "additionalProperties": false
    },
    "instances": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$": {
          "$ref": "#/$defs/card_instance"
        }
      },
      "additionalProperties": false
    },
    "operations": {
      "type": "object",
      "patternProperties": {
        "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$": {
          "$ref": "#/$defs/operation_record"
        }
      },
      "additionalProperties": false
    },
    "definition_manifest": {
      "$ref": "#/$defs/definition_manifest"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/domain_event"
      }
    }
  },
  "$defs": {
    "uuid4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "row": {
      "enum": [
        "melee",
        "ranged",
        "siege"
      ]
    },
    "zone": {
      "enum": [
        "hand",
        "draw_pile",
        "board",
        "discard"
      ]
    },
    "player": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "zones",
        "round_state"
      ],
      "properties": {
        "zones": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hand",
            "draw_pile",
            "board",
            "discard"
          ],
          "properties": {
            "hand": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/uuid4"
              },
              "uniqueItems": true
            },
            "draw_pile": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/uuid4"
              },
              "uniqueItems": true
            },
            "board": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/uuid4"
              },
              "uniqueItems": true
            },
            "discard": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/uuid4"
              },
              "uniqueItems": true
            }
          }
        },
        "round_state": {
          "$ref": "#/$defs/round_state"
        }
      }
    },
    "definition_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "kind",
        "faction_id",
        "printed_row",
        "power_base",
        "rarity_id",
        "effect_id",
        "effect_params",
        "combo_tags",
        "catalog_release_id",
        "effect_registry_release_id",
        "balance_rules_release_id",
        "ruleset_release_id",
        "definition_digest",
        "intrinsic_weather_resistance"
      ],
      "properties": {
        "card_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "unit",
            "special",
            "relic"
          ]
        },
        "faction_id": {
          "enum": [
            "golden_order",
            "crimson_veil",
            "dark_moon",
            "the_forgotten"
          ]
        },
        "printed_row": {
          "oneOf": [
            {
              "$ref": "#/$defs/row"
            },
            {
              "type": "null"
            }
          ]
        },
        "power_base": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 15
        },
        "rarity_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Classificação apenas. Conforme BUF-001 aprovado, não pode ser input do resolvedor nem alterar qualquer resultado mecânico."
        },
        "effect_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "effect_params": {
          "type": "object"
        },
        "combo_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "catalog_release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "effect_registry_release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "balance_rules_release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ruleset_release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "definition_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Digest do snapshot mecânico resolvido, sem seu próprio campo definition_digest."
        },
        "intrinsic_weather_resistance": {
          "type": "integer",
          "minimum": 0,
          "description": "Resistência climática intrínseca e imutável da definição. Ausência no release de origem é materializada como 0."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unit"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "printed_row": {
                "$ref": "#/$defs/row"
              },
              "power_base": {
                "type": "integer",
                "minimum": 1,
                "maximum": 15
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "special",
                  "relic"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "printed_row": {
                "type": "null"
              },
              "power_base": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "runtime_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_row",
        "last_board_row",
        "bonus_grants",
        "protection_grants",
        "status_applications",
        "weather_resistance_modifiers",
        "activated_combo_ids",
        "effect_state"
      ],
      "properties": {
        "current_row": {
          "oneOf": [
            {
              "$ref": "#/$defs/row"
            },
            {
              "type": "null"
            }
          ],
          "description": "Posição atual; deve ser null fora da zona board."
        },
        "last_board_row": {
          "oneOf": [
            {
              "$ref": "#/$defs/row"
            },
            {
              "type": "null"
            }
          ],
          "description": "Projeção persistida da última fileira válida no campo; mantida quando a instância sai do board. Atualiza em movimento e saída do campo; fica null se nunca houve presença no board."
        },
        "bonus_grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bonus_grant"
          },
          "description": "Concessões ativas rastreáveis. O bônus total é projeção calculada pelas clamp policies do release; não persistir escalar agregado canônico."
        },
        "protection_grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protection_grant"
          },
          "description": "Concessões de proteção com cargas restantes; a soma compatível pode ser projetada para a UI."
        },
        "status_applications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/status_application"
          },
          "description": "Aplicações de estados rastreáveis. Contadores são projeções por status_id; limite de 2 marcas por status é validado semanticamente."
        },
        "weather_resistance_modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/weather_resistance_modifier"
          },
          "description": "Modificadores temporários de resistência climática; a resistência efetiva soma o atributo intrínseco aos modificadores ativos e aplica piso 0."
        },
        "activated_combo_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effect_state": {
          "type": "object"
        }
      }
    },
    "card_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "instance_id",
        "card_id",
        "exemplar_id",
        "owner_player_id",
        "origin_type",
        "definition_snapshot",
        "state"
      ],
      "properties": {
        "schema_version": {
          "const": 4
        },
        "instance_id": {
          "$ref": "#/$defs/uuid4"
        },
        "card_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "exemplar_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "owner_player_id": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)$"
        },
        "origin_type": {
          "enum": [
            "deck_exemplar",
            "catalog_deck",
            "generated_token",
            "equipped_relic_activation",
            "legacy_migration"
          ]
        },
        "definition_snapshot": {
          "$ref": "#/$defs/definition_snapshot"
        },
        "state": {
          "$ref": "#/$defs/runtime_state"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin_type": {
                "const": "deck_exemplar"
              }
            },
            "required": [
              "origin_type"
            ]
          },
          "then": {
            "properties": {
              "exemplar_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin_type": {
                "enum": [
                  "catalog_deck",
                  "generated_token",
                  "equipped_relic_activation"
                ]
              }
            },
            "required": [
              "origin_type"
            ]
          },
          "then": {
            "properties": {
              "exemplar_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "definition_snapshot": {
                "properties": {
                  "kind": {
                    "const": "unit"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "definition_snapshot"
            ]
          },
          "then": {
            "properties": {
              "state": {},
              "definition_snapshot": {
                "properties": {
                  "printed_row": {
                    "$ref": "#/$defs/row"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "definition_snapshot": {
                "properties": {
                  "kind": {
                    "enum": [
                      "special",
                      "relic"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "definition_snapshot"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "properties": {
                  "current_row": {
                    "type": "null"
                  },
                  "last_board_row": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "operation_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "fingerprint",
        "actor",
        "expected_revision",
        "revision_before",
        "revision_after",
        "result",
        "event_ids"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/uuid4"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "revision_before": {
          "type": "integer",
          "minimum": 0
        },
        "revision_after": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "type": "object",
          "required": [
            "status",
            "payload"
          ],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "payload": {
              "type": "object"
            }
          },
          "additionalProperties": true
        },
        "event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid4"
          }
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "type",
            "player_id"
          ],
          "properties": {
            "type": {
              "const": "player"
            },
            "player_id": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "required": [
            "type",
            "system_id"
          ],
          "properties": {
            "type": {
              "const": "system"
            },
            "system_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      ],
      "properties": {
        "type": {
          "enum": [
            "player",
            "system"
          ]
        },
        "player_id": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)$"
        },
        "system_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "definition_manifest": {
      "$ref": "#/$defs/definition_manifest_inline"
    },
    "definition_manifest_inline": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://soulsbo.local/schemas/card-game-definition-manifest.v1.json",
      "title": "Soulsbo Definition Manifest v1",
      "description": "Manifesto imutável por partida. Release IDs apontam para artefatos publicados; schema_version do envelope não é release de conteúdo.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_version",
        "canonicalization",
        "catalog_release_id",
        "effect_registry_release_id",
        "balance_rules_release_id",
        "ruleset_release_id",
        "artifact_sha256",
        "definition_digest"
      ],
      "properties": {
        "manifest_version": {
          "const": 1
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "catalog_release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "effect_registry_release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "balance_rules_release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ruleset_release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "artifact_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalog",
            "effect_registry",
            "balance_rules",
            "ruleset"
          ],
          "properties": {
            "catalog": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "effect_registry": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "balance_rules": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "ruleset": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "definition_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 de JCS/RFC8785 do objeto manifesto sem o próprio campo definition_digest."
        }
      }
    },
    "domain_event": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://soulsbo.local/schemas/card-game-domain-event.v1.json",
      "title": "Soulsbo Domain Event v1",
      "description": "Evento de domínio append-only, ordenado e causalmente ligado a uma operação lógica.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "operation_id",
        "sequence",
        "caused_by_event_ids",
        "kind",
        "effect_scope",
        "source_effect_id",
        "source_instance_id",
        "target_instance_ids",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "caused_by_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "effect_scope": {
          "enum": [
            "direct",
            "reactive",
            "system"
          ]
        },
        "source_effect_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_instance_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "target_instance_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effect_scope": {
                "const": "reactive"
              }
            },
            "required": [
              "effect_scope"
            ]
          },
          "then": {
            "properties": {
              "source_effect_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect_scope": {
                "const": "direct"
              }
            },
            "required": [
              "effect_scope"
            ]
          },
          "then": {
            "properties": {
              "source_effect_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "expires_on": {
      "enum": [
        "board_exit",
        "zone_exit",
        "round_close",
        "permanent_instance"
      ]
    },
    "round_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_unit_play_row"
      ],
      "properties": {
        "last_unit_play_row": {
          "oneOf": [
            {
              "$ref": "#/$defs/row"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fileira da última unidade jogada com sucesso pelo participante nesta rodada; movimento, carta especial e retorno não atualizam."
        }
      }
    },
    "bonus_grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "amount",
        "source_effect_id",
        "source_instance_id",
        "applied_event_id",
        "expires_on",
        "clamp_policy_id"
      ],
      "properties": {
        "grant_id": {
          "$ref": "#/$defs/uuid4"
        },
        "amount": {
          "type": "integer",
          "description": "Delta assinado; interpretação e clamp são definidos pela clamp_policy_id versionada."
        },
        "source_effect_id": {
          "type": "string",
          "minLength": 1
        },
        "source_instance_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid4"
            },
            {
              "type": "null"
            }
          ]
        },
        "applied_event_id": {
          "$ref": "#/$defs/uuid4"
        },
        "expires_on": {
          "$ref": "#/$defs/expires_on"
        },
        "clamp_policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "protection_grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "profile_id",
        "charges",
        "source_effect_id",
        "source_instance_id",
