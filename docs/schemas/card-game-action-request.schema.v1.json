{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulsbo.local/schemas/card-game-action-request.v1.json",
  "title": "Soulsbo action request v1 (Group D candidate)",
  "description": "Candidate request envelope for future action resolver. Not wired to the current API; expected_revision enforcement and idempotency persistence belong to Group E.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "type": "string",
      "enum": [
        "play",
        "leader",
        "relic",
        "pass",
        "mulligan",
        "keep",
        "surrender"
      ]
    },
    "source_instance_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "target_row": {
      "type": "string",
      "enum": [
        "melee",
        "ranged",
        "siege"
      ]
    },
    "choice_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "none"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "manual_single"
            },
            "target_instance_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "mode",
            "target_instance_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "manual_set"
            },
            "target_instance_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          },
          "required": [
            "mode",
            "target_instance_ids"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "automatic"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "manual_primary_auto_fill"
            },
            "target_instance_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "preview_token": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "target_instance_id",
            "preview_token"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "expected_revision",
    "action",
    "selection"
  ]
}
