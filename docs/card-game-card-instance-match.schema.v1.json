{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulsbo.local/schemas/card-instance-match.v1.json",
  "title": "Soulsbo Match Card Instance Contract v1 (candidate)",
  "description": "Contrato candidato para identidade física de cartas e zonas de partida. Não integrado ao runtime legado.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "match_id",
    "state_revision",
    "status",
    "players",
    "instances",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "match_id": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "active",
        "finished"
      ]
    },
    "players": {
      "type": "object",
      "minProperties": 2,
      "patternProperties": {
        "^-?(?:0|[1-9][0-9]*)$": {
          "$ref": "#/$defs/player"
        }
      },
      "additionalProperties": false
    },
    "instances": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$": {
          "$ref": "#/$defs/card_instance"
        }
      },
      "additionalProperties": false
    },
    "operations": {
      "type": "object",
      "patternProperties": {
        "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$": {
          "$ref": "#/$defs/operation_record"
        }
      },
      "additionalProperties": false
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "row": {
      "enum": [
        "melee",
        "ranged",
        "siege"
      ]
    },
    "zone": {
      "enum": [
        "hand",
        "draw_pile",
        "board",
        "discard"
      ]
    },
    "player": {
      "type": "object",
      "required": [
        "zones"
      ],
      "properties": {
        "zones": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hand",
            "draw_pile",
            "board",
            "discard"
          ],
          "properties": {
            "hand": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "draw_pile": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "board": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "discard": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "definition_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_version",
        "balance_rules_version",
        "card_id",
        "kind",
        "faction_id",
        "printed_row",
        "power_base",
        "rarity_id",
        "effect_id",
        "effect_params",
        "combo_tags"
      ],
      "properties": {
        "catalog_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "balance_rules_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "card_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "unit",
            "special",
            "relic"
          ]
        },
        "faction_id": {
          "enum": [
            "golden_order",
            "crimson_veil",
            "dark_moon",
            "the_forgotten"
          ]
        },
        "printed_row": {
          "oneOf": [
            {
              "$ref": "#/$defs/row"
            },
            {
              "type": "null"
            }
          ]
        },
        "power_base": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 15
        },
        "rarity_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "effect_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "effect_params": {
          "type": "object"
        },
        "combo_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unit"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "printed_row": {
                "$ref": "#/$defs/row"
              },
              "power_base": {
                "type": "integer",
                "minimum": 1,
                "maximum": 15
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "special",
                  "relic"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "printed_row": {
                "type": "null"
              },
              "power_base": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "runtime_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_row",
        "bonus",
        "shield_charges",
        "statuses",
        "weather_resistance",
        "activated_combo_ids",
        "effect_state"
      ],
      "properties": {
        "current_row": {
          "oneOf": [
            {
              "$ref": "#/$defs/row"
            },
            {
              "type": "null"
            }
          ]
        },
        "bonus": {
          "type": "integer"
        },
        "shield_charges": {
          "type": "integer",
          "minimum": 0
        },
        "statuses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status.bleeding",
            "status.frost",
            "status.scarlet_rot",
            "status.madness"
          ],
          "properties": {
            "status.bleeding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "status.frost": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "status.scarlet_rot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "status.madness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        "weather_resistance": {
          "type": "integer",
          "minimum": 0
        },
        "activated_combo_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effect_state": {
          "type": "object"
        }
      }
    },
    "card_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "instance_id",
        "card_id",
        "exemplar_id",
        "owner_player_id",
        "origin_type",
        "definition_snapshot",
        "state"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "card_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "exemplar_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "owner_player_id": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)$"
        },
        "origin_type": {
          "enum": [
            "deck_exemplar",
            "catalog_deck",
            "generated_token",
            "equipped_relic_activation",
            "legacy_migration"
          ]
        },
        "definition_snapshot": {
          "$ref": "#/$defs/definition_snapshot"
        },
        "state": {
          "$ref": "#/$defs/runtime_state"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin_type": {
                "const": "deck_exemplar"
              }
            },
            "required": [
              "origin_type"
            ]
          },
          "then": {
            "properties": {
              "exemplar_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "definition_snapshot": {
                "properties": {
                  "kind": {
                    "const": "unit"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "definition_snapshot"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "properties": {
                  "current_row": {
                    "$ref": "#/$defs/row"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "definition_snapshot": {
                "properties": {
                  "kind": {
                    "enum": [
                      "special",
                      "relic"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "definition_snapshot"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "properties": {
                  "current_row": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "operation_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "instance_id",
        "player_id",
        "from_zone",
        "to_zone",
        "state_policy_id",
        "result",
        "expected_revision",
        "revision_before",
        "revision_after"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "player_id": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)$"
        },
        "from_zone": {
          "$ref": "#/$defs/zone"
        },
        "to_zone": {
          "$ref": "#/$defs/zone"
        },
        "state_policy_id": {
          "type": "string",
          "const": "policy.identity_only"
        },
        "result": {
          "type": "string",
          "const": "applied"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "revision_before": {
          "type": "integer",
          "minimum": 0
        },
        "revision_after": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
